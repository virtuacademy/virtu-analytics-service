# Google Ads (offline click conversions + enhanced conversions for leads)
GOOGLE_ADS_DEVELOPER_TOKEN="..."
GOOGLE_ADS_CLIENT_ID="..."
GOOGLE_ADS_CLIENT_SECRET="..."
GOOGLE_ADS_REFRESH_TOKEN="..."
# Google Ads conversion customer ID (digits only)
GOOGLE_ADS_CUSTOMER_ID="1234567890"
# Required if using a manager account
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
# Conversion action ID or resource name (UPLOAD_CLICKS)
GOOGLE_ADS_CONVERSION_ACTION_ID="1234567890"
# Optional per-event overrides: "TRIAL_BOOKED=1234567890,TRIAL_RESCHEDULED=2345678901"
GOOGLE_ADS_CONVERSION_ACTIONS="TRIAL_BOOKED=1234567890"
# Consent values: GRANTED or DENIED
GOOGLE_ADS_AD_USER_DATA_CONSENT="GRANTED"
GOOGLE_ADS_AD_PERSONALIZATION_CONSENT=""
# Use your Google Ads account timezone (IANA); offset overrides if set.
GOOGLE_ADS_CONVERSION_TIMEZONE="America/New_York"
GOOGLE_ADS_CONVERSION_TIMEZONE_OFFSET="-05:00"
# Default phone country code when phone lacks + prefix
GOOGLE_ADS_DEFAULT_PHONE_COUNTRY_CODE="1"
GOOGLE_ADS_DEBUG_ENABLED="false"
GOOGLE_ADS_VALIDATE_ONLY="false"
GOOGLE_ADS_JOB_ID=""
# Test endpoint auth (POST /api/test/google-ads)
GOOGLE_ADS_TEST_SECRET="change-me"

# TikTok Events API
TIKTOK_PIXEL_ID="..."
TIKTOK_ACCESS_TOKEN="..."
TIKTOK_EVENT_ACTIONS="TRIAL_BOOKED=SubmitForm,TRIAL_RESCHEDULED=SubmitForm,APPOINTMENT_UPDATED=Schedule"
TIKTOK_TEST_EVENT_CODE=""
TIKTOK_DEFAULT_PHONE_COUNTRY_CODE="1"
# Test endpoint auth (POST /api/test/tiktok)
TIKTOK_TEST_SECRET="change-me"

# Set to "mock" to simulate outbound deliveries without external calls
OUTBOUND_MODE=""

# Simple password protection for the dashboard
# If not set, authentication is disabled (for local development)
AUTH_PASSWORD=""

# Provided by platform/runtime (optional in local dev)
NODE_ENV="development"
VERCEL_ENV=""
