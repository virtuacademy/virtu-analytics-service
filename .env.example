DATABASE_URL="postgresql://..."
# ChatGPT Ads Conversions API (Ads Manager > Conversions; server-only)
OPENAI_CAPI_API_KEY=""
OPENAI_CAPI_PIXEL_ID=""
# Enable after account and measurement setup; default is no delivery.
OPENAI_CAPI_ENABLED="false"
# Validation checks payloads without recording conversions. Set false for real delivery.
OPENAI_CAPI_VALIDATE_ONLY="true"
# Optional APPOINTMENT_BOOKED includes repeat lesson bookings; updates/cancellations never send.
OPENAI_CAPI_EVENTS="TRIAL_BOOKED"
# Optional country prefix for national 10-digit phone numbers, e.g. 1 for US/Canada.
OPENAI_CAPI_DEFAULT_PHONE_COUNTRY_CODE=""

DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:6543/virtu_analytics_test?schema=public"
# Required to allow test DB truncation (tests will refuse to reset without this)
TEST_DB_ALLOW_RESET="false"

PUBLIC_BASE_URL="https://attrib.virtu.academy"
ALLOWED_ORIGINS="https://virtu.academy,https://www.virtu.academy"
COOKIE_DOMAIN=".virtu.academy"

ACUITY_USER_ID="..."
ACUITY_API_KEY="..."
ACUITY_WEBHOOK_FORWARD_URL=""

ACUITY_TRIAL_APPOINTMENT_TYPE_IDS="12345,67890"
