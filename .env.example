DATABASE_URL="postgresql://..."
# ChatGPT Ads Conversions API (Ads Manager > Conversions; server-only)
# npm run openai-capi:test-backend uses local QSTASH_TOKEN and the deployed CAPI credentials.
OPENAI_CAPI_API_KEY=""
OPENAI_CAPI_PIXEL_ID=""
# Enable after account and measurement setup; default is no delivery.
OPENAI_CAPI_ENABLED="false"
# Validation checks payloads without recording conversions. Set false for real delivery.
OPENAI_CAPI_VALIDATE_ONLY="true"
# Optional APPOINTMENT_BOOKED includes repeat lesson bookings; updates/cancellations never send.
OPENAI_CAPI_EVENTS="TRIAL_BOOKED"
# Optional country prefix for national 10-digit phone numbers, e.g. 1 for US/Canada.
OPENAI_CAPI_DEFAULT_PHONE_COUNTRY_CODE=""

DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:6543/virtu_analytics_test?schema=public"
# Required to allow test DB truncation (tests will refuse to reset without this)
TEST_DB_ALLOW_RESET="false"

PUBLIC_BASE_URL="https://attrib.virtu.academy"
# Origins that may call /api/attrib/ingest and /api/attrib/event: virtu.academy, the trial page
# and the Forte marketing site.
ALLOWED_ORIGINS="https://virtu.academy,https://www.virtu.academy,https://lessons.virtu.academy,https://www.fortelessons.com,https://fortelessons.com"
COOKIE_DOMAIN=".virtu.academy"

ACUITY_USER_ID="..."
ACUITY_API_KEY="..."
ACUITY_WEBHOOK_FORWARD_URL=""

ACUITY_TRIAL_APPOINTMENT_TYPE_IDS="12345,67890"
ACUITY_TRIAL_APPOINTMENT_TYPE_ID=""

ACUITY_FIELD_VA_ATTRIB_ID="111"
ACUITY_FIELD_GCLID_ID="112"
ACUITY_FIELD_TTCLID_ID="113"
ACUITY_FIELD_FBP_ID="114"
ACUITY_FIELD_FBC_ID="115"

# Opus trial bookings (POST /api/webhooks/opus; docs/opus-trial-webhook.md)
# Shared HMAC secret; same value as ATTRIB_WEBHOOK_SECRET in Opus. The endpoint answers 500 without it.
OPUS_WEBHOOK_SECRET=""
# Platforms that receive Opus bookings: GOOGLE_ADS,HUBSPOT,META. Empty records bookings without delivering.
# Opus accounts go to GOOGLE_ADS and META only, each once its own "opus:EVENT" entries exist below.
OPUS_DELIVERY_PLATFORMS=""

# Page events (POST /api/attrib/event; docs/page-events.md)
# Platforms that receive them: GOOGLE_ADS,META. Empty records events without delivering, which
# is also how to stop a flood of forged events.
PAGE_DELIVERY_PLATFORMS=""
# Page events accepted per 24 hours from one IPv4 address or IPv6 /64 network (default 3).
# Further ones are refused: nothing is written, one line is logged.
PAGE_EVENT_DAILY_LIMIT_PER_IP=""
# Accepted page events per 24 hours, from everyone, beyond which each one logs a "[page-events]" error
# line (default 25). An alarm only: it never stops delivery.
PAGE_EVENT_DAILY_ALERT_THRESHOLD=""

# USD values for events that carry none, as "source:EVENT=amount". Unset sends no value.
EVENT_VALUES="opus:ACCOUNT_CREATED=15,opus:TEACHER_ACCOUNT_CREATED=15,page:CALLBACK_REQUESTED=15"

QSTASH_TOKEN="..."
QSTASH_CURRENT_SIGNING_KEY="..."
QSTASH_NEXT_SIGNING_KEY="..."

HUBSPOT_PRIVATE_APP_TOKEN="..."
HUBSPOT_EVENT_NAMES="TRIAL_BOOKED=pe1234567_trial_booked"
HUBSPOT_SOURCE_SYSTEM="attrib.virtu.academy"
HUBSPOT_TEST_SECRET="change-me"

META_PIXEL_ID="..."
META_CAPI_ACCESS_TOKEN="..."
META_CAPI_EVENT_NAME=""
# Opus and page events need their own "source:EVENT=Name" entry and never fall back to Acuity's name.
META_CAPI_EVENT_NAMES="TRIAL_BOOKED=SubmitApplication,opus:TRIAL_BOOKED=Purchase,opus:ACCOUNT_CREATED=CompleteRegistration,opus:TEACHER_ACCOUNT_CREATED=TeacherRegistration,page:CALLBACK_REQUESTED=Lead"
META_CAPI_TEST_EVENT_CODE=""
META_CAPI_TEST_SECRET="change-me"
META_CAPI_API_VERSION="v24.0"
META_CAPI_LDU_ENABLED="false"
META_CAPI_PREDICTED_LTV=""

# Google Ads (offline click conversions + enhanced conversions for leads)
GOOGLE_ADS_DEVELOPER_TOKEN="..."
GOOGLE_ADS_CLIENT_ID="..."
GOOGLE_ADS_CLIENT_SECRET="..."
GOOGLE_ADS_REFRESH_TOKEN="..."
# Google Ads conversion customer ID (digits only)
GOOGLE_ADS_CUSTOMER_ID="1234567890"
# Required if using a manager account
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
# Conversion action ID or resource name (UPLOAD_CLICKS)
GOOGLE_ADS_CONVERSION_ACTION_ID="1234567890"
# Optional per-event overrides: "TRIAL_BOOKED=1234567890,TRIAL_RESCHEDULED=2345678901"
# Opus and page events need their own "source:EVENT=ID" entry and never fall back to the Acuity action.
GOOGLE_ADS_CONVERSION_ACTIONS="TRIAL_BOOKED=1234567890,opus:TRIAL_BOOKED=2345678901,opus:ACCOUNT_CREATED=3456789012,opus:TEACHER_ACCOUNT_CREATED=4567890123,page:CALLBACK_REQUESTED=5678901234"
# Consent values: GRANTED or DENIED
GOOGLE_ADS_AD_USER_DATA_CONSENT="GRANTED"
GOOGLE_ADS_AD_PERSONALIZATION_CONSENT=""
# Use your Google Ads account timezone (IANA); offset overrides if set.
GOOGLE_ADS_CONVERSION_TIMEZONE="America/New_York"
GOOGLE_ADS_CONVERSION_TIMEZONE_OFFSET="-05:00"
# Default phone country code when phone lacks + prefix
GOOGLE_ADS_DEFAULT_PHONE_COUNTRY_CODE="1"
GOOGLE_ADS_DEBUG_ENABLED="false"
# true: Google checks uploads but records nothing; deliveries are marked SKIPPED, not SUCCESS.
GOOGLE_ADS_VALIDATE_ONLY="false"
GOOGLE_ADS_JOB_ID=""
# Test endpoint auth (POST /api/test/google-ads)
GOOGLE_ADS_TEST_SECRET="change-me"

# TikTok Events API
TIKTOK_PIXEL_ID="..."
TIKTOK_ACCESS_TOKEN="..."
TIKTOK_EVENT_ACTIONS="TRIAL_BOOKED=SubmitForm,TRIAL_RESCHEDULED=SubmitForm,APPOINTMENT_UPDATED=Schedule"
TIKTOK_TEST_EVENT_CODE=""
TIKTOK_DEFAULT_PHONE_COUNTRY_CODE="1"
# Test endpoint auth (POST /api/test/tiktok)
TIKTOK_TEST_SECRET="change-me"

# Set to "mock" to simulate outbound deliveries without external calls
OUTBOUND_MODE=""

# Simple password protection for the dashboard
# If not set, authentication is disabled (for local development)
AUTH_PASSWORD=""

# Provided by platform/runtime (optional in local dev)
NODE_ENV="development"
VERCEL_ENV=""
